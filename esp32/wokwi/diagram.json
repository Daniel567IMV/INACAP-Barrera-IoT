    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:5V", "sensor:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "sensor:GND", "black", [ "v0" ] ],
