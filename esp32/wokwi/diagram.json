      "id": "sensor",
      "top": -120,
      "left": -180,
      "attrs": { "distance": "50" }
    },
    { "type": "wokwi-servo", "id": "servo", "top": -120, "left": 150, "attrs": {} },
    { "type": "wokwi-lcd1602", "id": "lcd", "top": 256, "left": 53.6, "attrs": { "pins": "i2c" } }
